generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  name                  String?
  microsoftId           String?  @unique
  encryptedRefreshToken String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
