generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Emit ESM imports with explicit .js extensions so the compiled client
  // resolves under Node's ESM loader in production (tsx tolerates either in dev).
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id          String    @id @default(cuid())
  name        String
  suspendedAt DateTime? // non-null = suspended: users lose all API access incl. login
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  users                   User[]
  mailboxes               Mailbox[]
  orders                  Order[]
  appointmentFieldConfigs AppointmentFieldConfig[]
  appointments            Appointment[]
  usageEvents             UsageEvent[]
}

model User {
  id           String        @id @default(cuid())
  orgId        String?
  org          Organization? @relation(fields: [orgId], references: [id])
  email        String        @unique
  passwordHash String
  // Bumped on password change; sessions carrying an older "sv" are rejected.
  sessionVersion Int         @default(0)
  role         String        @default("member")
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  mailboxes    Mailbox[]     @relation("ConnectedBy")
  orders       Order[]       @relation("CreatedBy")
  flaggedOrders Order[]      @relation("FlaggedBy")
}

model Mailbox {
  id                    String       @id @default(cuid())
  orgId                 String
  org                   Organization @relation(fields: [orgId], references: [id])
  microsoftId           String       @unique
  email                 String
  type                  String
  encryptedRefreshToken String
  connectedByUserId     String
  connectedBy           User         @relation("ConnectedBy", fields: [connectedByUserId], references: [id])
  lastPolledAt          DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  orders                Order[]
  appointments          Appointment[]
  seenMessages          SeenMessage[]
}

// Dedupe ledger for the inbox poll overlap window. The poll re-fetches a 2-min
// buffer before its watermark (clock-skew/late-mail safety), so the boundary
// message is re-listed every cycle. Without a record, junk classified "other"
// (which persists nothing) gets re-sent to the LLM forever. We mark every
// processed message here so a re-fetch is skipped, not re-metered or re-extracted.
// Bounded: rows older than (watermark - overlap) can never be re-fetched and are pruned.
model SeenMessage {
  mailboxId        String
  mailbox          Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  graphMessageId   String
  receivedDateTime DateTime
  createdAt        DateTime @default(now())

  @@id([mailboxId, graphMessageId])
  @@index([mailboxId, receivedDateTime]) // prune by watermark
}

model Order {
  id                  String       @id @default(cuid())
  orgId               String
  org                 Organization @relation(fields: [orgId], references: [id])
  mailboxId           String
  mailbox             Mailbox      @relation(fields: [mailboxId], references: [id])
  createdByUserId     String
  createdBy           User         @relation("CreatedBy", fields: [createdByUserId], references: [id])
  vendorEmail         String
  chassisSeries       String
  partCode            String
  registrationNumber  String?
  offerPrice          String?
  status              String       @default("În așteptare")
  orderNumber         String?
  deliveryTime        String?
  deliveryEarliest    DateTime?
  deliveryLatest      DateTime?
  statusRequestSentAt DateTime?
  closedAt            DateTime? // terminal: closed orders leave the poll/extract/nudge pipeline
  internetMessageId   String?
  emailStatus         String       @default("trimis")
  replyStatus         String       @default("awaiting_reply")
  extractionAttempts  Int          @default(0) // hard-failure retry counter; at MAX flips replyStatus to extraction_failed
  orderNumberConfidence String?    // "high" | "low" — deterministic extraction confidence
  deliveryConfidence    String?    // "high" | "low"
  reviewReasons         String?    // newline-joined Romanian reasons shown in the review UI
  // User-reported "this order is wrong" flag, surfaced on the superadmin dashboard.
  flaggedAt           DateTime?
  flaggedByUserId     String?
  flaggedBy           User?        @relation("FlaggedBy", fields: [flaggedByUserId], references: [id])
  flagReason          String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  replies             OrderReply[]

  @@index([orgId, createdAt, id]) // listOrders cursor pagination
  @@index([replyStatus]) // poll extract phase
  @@index([flaggedAt]) // superadmin flagged-orders list
}

model OrderReply {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id])
  graphMessageId    String   @unique
  internetMessageId String?
  fromEmail         String
  subject           String?
  receivedDateTime  DateTime
  hasAttachments    Boolean  @default(false)
  body              String?
  createdAt         DateTime @default(now())

  @@index([orderId, receivedDateTime]) // per-order reply lookups + sort
}

model Log {
  id        String   @id @default(cuid())
  level     String // "info" | "warn" | "error"
  source    String // "frontend" | "backend"
  message   String
  stack     String?
  context   Json?
  requestId String? // correlates a frontend action to the backend request it triggered
  userId    String?
  orgId     String?
  url       String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([level])
  @@index([source])
  @@index([requestId])
}

model UsageEvent {
  id               String       @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id])
  kind             String // "llm" | "email_read" | "email_write" | "classification"
  provider         String? // "openai" | "gemini"
  model            String?
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  costUsd          Float        @default(0)
  emails           Int          @default(0) // count for email_read / email_write
  outcome          String? // classification: "appointment" | "other"
  createdAt        DateTime     @default(now())

  @@index([orgId, createdAt])
}

model AppointmentFieldConfig {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  key         String
  label       String
  description String
  required    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([orgId, key])
}

model Appointment {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  mailboxId      String
  mailbox        Mailbox      @relation(fields: [mailboxId], references: [id])
  customerEmail  String
  conversationId String
  status         String       @default("collecting") // collecting | complete
  fields         Json         @default("{}")
  lastMessageAt  DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([mailboxId, conversationId])
  @@index([orgId, createdAt, id])
}
