# docker-compose overrides (DB creds + host ports). Copy to .env on the VPS.
# App secrets (OAuth, LLM keys, SESSION_SECRET, ...) live in backend/.env.
POSTGRES_USER=trenda
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trenda
POSTGRES_PORT=5432
BACKEND_PORT=3000
# set true on first boot to seed the superadmin, then back to false
RUN_SEED=false
