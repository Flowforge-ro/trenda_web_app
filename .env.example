# docker-compose overrides. Copy to .env on the VPS (never commit the real .env).
# App secrets (OAuth, LLM keys, SESSION_SECRET, ENCRYPTION_KEY) live in backend/.env.

# Public hostname served by Caddy (also drives the OAuth redirect + frontend origin).
APP_DOMAIN=app.flowforge.ro

# Postgres
POSTGRES_USER=trenda
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trenda
POSTGRES_PORT=5432

# Cloudflare API token, scoped Zone:DNS:Edit for the flowforge.ro zone.
# Used by Caddy for the DNS-01 ACME challenge (works with the CF proxy on).
CLOUDFLARE_API_TOKEN=cfut_xxx

# set true on first boot to seed the superadmin, then back to false
RUN_SEED=false
